{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.x/crates/tauri-cli/config.schema.json",
  "productName": "AI Life Timeline",
  "version": "1.0.0",
  "identifier": "com.farisasim.life-timeline",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "bun dev -p 3000",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Life Timeline",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app"
    ],
    "resources": [
      "resources/node.exe",
      "../.next/standalone/**/*",
      "../.next/static/**/*",
      "../public/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}